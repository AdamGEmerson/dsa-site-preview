---
// Every page except Home. EmDash matches the path against each collection's URL pattern (Pages at
// /{slug}) and loads the entry, or a draft on a signed preview link.
import { resolveEmDashPath } from "emdash";
import Base from "@/layouts/Base.astro";
import Hero from "@/components/shell/Hero.astro";
import PageBlocks from "@/components/blocks/PageBlocks.astro";
import { seoFor, type Entry } from "@/lib/site";
import { faqPage } from "@/lib/schema";

const path = `/${Astro.params.path ?? ""}`;
const found = await resolveEmDashPath(path);
if (!found) return Astro.rewrite("/404");
const entry = found.entry as unknown as Entry;
const d = entry.data;
const seo = await seoFor(Astro, entry, path);
---

<Base {...seo} content={{ collection: found.collection, id: d.id, slug: d.slug }} schema={[faqPage(d.content)]}>
  <Hero entry={entry} variant="page" />
  <PageBlocks blocks={d.content} edit={entry.edit?.content} />
</Base>
