---
// Line icons drawn for the site (24px grid, 2.2px stroke). Decorative unless given a label.
const paths = {
  arrow: '<path d="M4 12h15M13 5.5 19.5 12 13 18.5"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  pin: '<path d="M12 21.5s-7-6.6-7-12a7 7 0 0 1 14 0c0 5.4-7 12-7 12Z"/><circle cx="12" cy="9.5" r="2.6"/>',
  video: '<rect x="2.5" y="6" width="13.5" height="12" rx="1.5"/><path d="m16 10.5 5.5-3.5v10L16 13.5"/>',
  check: '<path d="m4.5 12.5 5 5L19.5 7"/>',
  plus: '<path d="M12 4.5v15M4.5 12h15"/>',
  menu: '<path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/>',
  close: '<path d="m5.5 5.5 13 13M18.5 5.5l-13 13"/>',
  mail: '<rect x="2.5" y="5" width="19" height="14" rx="1"/><path d="m3 6.5 9 6.5 9-6.5"/>',
  star: '<path fill="currentColor" stroke="none" d="m12 1.8 3 7 7.6.6-5.8 5 1.8 7.4L12 17.8l-6.6 4 1.8-7.4-5.8-5 7.6-.6z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>',
  facebook: '<path d="M14.5 21v-7.5h3l.5-3.5h-3.5V8.2c0-1 .4-1.7 1.8-1.7H18V3.4c-.4 0-1.6-.2-2.9-.2-2.8 0-4.6 1.7-4.6 4.8V10H7.5v3.5h3V21"/>',
  x: '<path d="M4 4h4.2L20 20h-4.2zM19.5 4l-6.6 7.3M4.5 20l6.6-7.3"/>',
  bluesky: '<path d="M12 11.2C10.6 8.4 6.8 3.4 4 3.4c-1.7 0-1.6 2.6-1.3 4.8.4 2.6 2.4 4.1 5.5 3.7-3.6.9-4.6 3.1-2.6 5.2 3.4 3.6 5.4-.4 6.4-3.3 1 2.9 3 6.9 6.4 3.3 2-2.1 1-4.3-2.6-5.2 3.1.4 5.1-1.1 5.5-3.7.3-2.2.4-4.8-1.3-4.8-2.8 0-6.6 5-8 7.8Z"/>',
  tiktok: '<path d="M14 3v12.2a3.8 3.8 0 1 1-3.8-3.8M14 3c.4 2.8 2.3 4.6 5 4.8"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path fill="currentColor" stroke="none" d="m10 9 5 3-5 3z"/>',
  threads: '<path d="M16.5 11.2c-.5-2.6-2.4-3.7-4.5-3.7-2.5 0-4 1.5-4.2 3.2M16.6 11.4c2.6 1 3.4 3.3 2.7 5.3-1 2.7-3.8 4-7.2 4-4.6 0-8-3.2-8-8.7S7.5 3.3 12 3.3c3.4 0 6 1.6 7.2 4.4M16.6 11.4c-.6-.1-1.6-.3-3-.3-2.7 0-4.4 1-4.3 2.7.1 1.6 1.7 2.4 3.4 2.3 2.5-.2 3.7-1.9 3.9-4.7"/>',
  pause: '<path d="M8.5 5v14M15.5 5v14"/>',
  play: '<path fill="currentColor" d="M7 4.5v15l12.5-7.5z"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10.5" rx="1"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  link: '<path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L12 5.6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4L12 18.4"/>',
} as const;
export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  class?: string;
  label?: string;
}
const { name, class: cls, label } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={paths[name] ?? paths.link}
/>
