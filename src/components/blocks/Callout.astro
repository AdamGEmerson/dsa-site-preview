---
// Callout band. Red and dark: the loud strip, the eyebrow as a starburst sticker, big ruled action links.
// Soft: a pink ruled card on newsprint (the newsletter ask).
import Eyebrow from "@/components/ui/Eyebrow.astro";
import RichText from "@/components/ui/RichText.astro";
import Buttons from "@/components/ui/Buttons.astro";
import Icon from "@/components/ui/Icon.astro";
import PhotoBg from "@/components/ui/PhotoBg.astro";
import Sticker from "@/components/ui/Sticker.astro";
import { isExternal } from "@/lib/site";
const { block: b } = Astro.props as { block: Record<string, any> };
const tone = b.tone || "red";
const actions = ((b.actions ?? []) as { label: string; url: string }[]).filter((a) => a.label && a.url);
const id = `h-${b._key}`;
---

{
  tone === "soft" ? (
    <section class="band callout soft" aria-labelledby={id}>
      <div class="wrap">
        <div class="soft-card">
          <Icon name="mail" class="envelope" />
          <div>
            <Eyebrow text={b.eyebrow} />
            <h2 id={id} class="display h-band">{b.heading}</h2>
            <RichText value={b.body} />
          </div>
          <Buttons buttons={b.buttons} />
        </div>
      </div>
    </section>
  ) : (
    <section class:list={["band callout", tone, tone === "red" ? "on-red" : "dark", { "has-photo": b.image?.id }]} aria-labelledby={id}>
      <PhotoBg image={b.image} focus={b.image_focus} />
      <div class:list={["wrap callout-grid", { "has-actions": actions.length > 0 }]}>
        <div>
          {b.eyebrow && <p class="callout-sticker"><Sticker text={b.eyebrow} /></p>}
          <h2 id={id} class="display h-band">{b.heading}</h2>
          <RichText value={b.body} />
          <Buttons buttons={b.buttons} />
        </div>
        {actions.length > 0 && (
          <ul class="actions">
            {actions.map((a) => (
              <li>
                <a class="action" href={a.url} rel={isExternal(a.url) ? "noopener" : undefined}>
                  <span>
                    {a.label}
                  </span>
                  <span class="go"><Icon name="arrow" /></span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
