---
// Renders a page's "Page content" blocks in order, each as a full-width band.
import Split from "./Split.astro";
import Callout from "./Callout.astro";
import Events from "./Events.astro";
import FeaturedEvents from "./FeaturedEvents.astro";
import EventList from "./EventList.astro";
import Cards from "./Cards.astro";
import Groups from "./Groups.astro";
import Checklist from "./Checklist.astro";
import Faq from "./Faq.astro";
import Text from "./Text.astro";
import Gallery from "./Gallery.astro";
import Contact from "./Contact.astro";
import Notice from "./Notice.astro";
import EmbedForm from "./EmbedForm.astro";
import Logos from "./Logos.astro";
import FinalCta from "./FinalCta.astro";
import UnknownBlock from "./UnknownBlock.astro";

interface Props {
  blocks?: (Record<string, any> & { _type: string })[] | null;
  edit?: Record<string, string>; // visual-editing attributes for the content field
}
const { blocks = [], edit } = Astro.props;
const renderers: Record<string, any> = { split: Split, callout: Callout, events: Events, featured_events: FeaturedEvents, event_list: EventList, cards: Cards, groups: Groups, checklist: Checklist, faq: Faq, text: Text, gallery: Gallery, contact: Contact, notice: Notice, embed_form: EmbedForm, logos: Logos, final_cta: FinalCta };
---

<div {...edit} style="display:contents">
  {
    (blocks ?? []).map((block) => {
      const Block = renderers[block._type];
      return Block ? <Block block={block} /> : <UnknownBlock type={block._type} />;
    })
  }
</div>
