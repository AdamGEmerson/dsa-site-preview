{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dsa-fort-worth-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	// EmDash: content + schema in D1, media in R2. Wrangler creates both on the first deploy.
	"d1_databases": [{ "binding": "DB", "database_name": "dsa-fort-worth" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dsa-fort-worth-media" }],
	// Astro sessions (created on the first deploy)
	"kv_namespaces": [{ "binding": "SESSION", "id": "fd223ddc7b9f4f2593ee482efa9dbacc" }],
	// Resizes media for <Image> from emdash/ui (billed as Cloudflare Images transformations)
	"images": { "binding": "IMAGES" },
	// Scheduled publishing, backups and maintenance
	"triggers": { "crons": ["* * * * *"] },
	"observability": { "enabled": true },
	// Preview on workers.dev until dsafw.com is moved to this account. EMDASH_SITE_URL must be the
	// address the site is served from (also passed at build: npm run deploy:preview), or images are
	// served full size and passkeys bind to the wrong host. ROBOTS_NOINDEX keeps the preview out of
	// search (src/middleware.ts). At launch: EMDASH_SITE_URL → https://dsafw.com, drop ROBOTS_NOINDEX.
	"vars": {
		"EMDASH_SITE_URL": "https://dsa-fort-worth-site.adamgemerson.workers.dev",
		"ROBOTS_NOINDEX": "true",
	},
	// Secret (never committed): npx wrangler secret put EMDASH_ENCRYPTION_KEY
	// (from `npx emdash secrets generate`). Locally it lives in .dev.vars.
}
